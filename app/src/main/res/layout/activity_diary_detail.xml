<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/echoBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- 顶栏：返回 + 操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_top_bar"
            android:elevation="3dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_echo_back"
                android:contentDescription="返回"
                app:tint="?attr/echoTextPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="日记详情"
                android:fontFamily="sans-serif-medium"
                android:textSize="17sp"
                android:textColor="?attr/echoTextPrimary" />

            <ImageButton
                android:id="@+id/btn_read_aloud"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_echo_speaker"
                android:contentDescription="朗读"
                app:tint="?attr/echoPrimary" />

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_echo_delete"
                android:contentDescription="删除"
                app:tint="?attr/echoDestructive" />
        </LinearLayout>

        <!-- 内容区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="26dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tv_detail_date"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_date_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:textColor="?attr/echoTextSecondary"
                tools:text="2025年6月24日" />

            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="30sp"
                android:textColor="?attr/echoTextPrimary"
                tools:text="今天的项目有了新进展" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_detail_mood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="?attr/echoPrimary"
                    android:background="@drawable/bg_message_assistant"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    tools:text="平静充实" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_detail_tags"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:singleLine="false"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="2dp" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/echoBorder" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_diary_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:checkedButton="@id/btn_view_diary"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_diary"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="整理后的日记"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_raw"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="原始片段"
                    android:textSize="13sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/tv_detail_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="?attr/echoTextPrimary"
                android:lineSpacingExtra="8dp"
                tools:text="日记正文内容..." />

            <TextView
                android:id="@+id/tv_detail_raw_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="8dp"
                android:textColor="?attr/echoTextPrimary"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="09:20 · 文字\n完成了今天最重要的一件事。"
                tools:visibility="visible" />

            <!-- 来源片段 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="来源片段"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/echoTextSecondary" />

            <TextView
                android:id="@+id/tv_source_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="?attr/echoHint"
                tools:text="基于 3 条生活记录生成" />

            <!-- 重新生成按钮（仅今日日记可见） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_regenerate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:text="重新生成"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="?attr/echoPrimary"
                android:textColor="?attr/echoPrimary"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
