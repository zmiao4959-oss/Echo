<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/echoBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="4dp"
            android:text="@string/memory_page_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/echoTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            android:text="@string/memory_page_subtitle"
            android:textSize="14sp"
            android:textColor="?attr/echoTextSecondary" />

        <!-- 搜索框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="@string/memory_search_hint"
                android:textSize="14sp"
                android:textColor="?attr/echoTextPrimary"
                android:textColorHint="?attr/echoHint"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_echo_search"
                android:contentDescription="搜索"
                app:tint="?attr/echoPrimary" />
        </LinearLayout>

        <!-- 搜索结果模式 -->
        <LinearLayout
            android:id="@+id/layout_search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tv_search_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textColor="?attr/echoTextSecondary"
                    tools:text='搜索 "项目": 5 条结果' />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_search"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="清除"
                    android:textSize="12sp"
                    android:textColor="?attr/echoPrimary" />
            </LinearLayout>

            <!-- 搜索结果内容 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/echoSurface"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tv_search_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="14sp"
                    android:textColor="?attr/echoTextPrimary"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true"
                    tools:text="── 生活片段 ──&#10;✏️ 今天完成了代码审查..." />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/memory_search_empty"
                android:textSize="14sp"
                android:textColor="?attr/echoHint"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 默认模式 -->
        <LinearLayout
            android:id="@+id/layout_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:text="记忆星图"
                android:textColor="?attr/echoTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="3dp"
                android:paddingBottom="8dp"
                android:text="星点是回忆 · 弧线是伏笔 · 轻触查看故事轨迹"
                android:textColor="?attr/echoHint"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="?attr/echoSurface"
                app:cardCornerRadius="24dp"
                app:strokeColor="?attr/echoBorder"
                app:strokeWidth="1dp">

                <com.example.myapplication.ui.widget.EchoMemoryMapView
                    android:id="@+id/memory_star_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 今天遇见的回忆 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/memory_today_echo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/echoTextPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_random"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="?attr/echoSurfaceVariant"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tv_random_quote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="italic"
                        android:textColor="?attr/echoTextPrimary"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        tools:text="「今天的项目有了新进展」" />

                    <TextView
                        android:id="@+id/tv_random_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textColor="?attr/echoHint"
                        tools:text="2025年6月24日" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="轻触换一条"
                        android:textColor="?attr/echoAccent"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_no_random"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/memory_no_cards"
                android:textSize="14sp"
                android:textColor="?attr/echoHint"
                android:visibility="gone" />

            <!-- 往日回声卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_on_this_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/echoSurface"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memory_past_echo"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/echoAccent" />

                    <TextView
                        android:id="@+id/tv_on_this_day_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="12sp"
                        android:textColor="?attr/echoHint"
                        tools:text="2024年6月25日" />

                    <TextView
                        android:id="@+id/tv_on_this_day_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/echoTextPrimary"
                        tools:text="项目有了重要进展" />

                    <TextView
                        android:id="@+id/tv_on_this_day_snippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="?attr/echoTextSecondary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="今天完成了代码审查，感觉..." />

                    <TextView
                        android:id="@+id/tv_on_this_day_echo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textColor="?attr/echoAccent"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="当时 Echo 说 · 这一步值得记住。" />

                    <TextView
                        android:id="@+id/tv_on_this_day_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/memory_view_echo"
                        android:textSize="13sp"
                        android:textColor="?attr/echoPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 记忆卡片列表 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="4dp"
                android:text="@string/memory_cards_section"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/echoTextPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_memory_card" />

            <TextView
                android:id="@+id/tv_empty_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/memory_empty_cards"
                android:textSize="13sp"
                android:textColor="?attr/echoHint"
                android:visibility="gone" />

            <!-- 长期记忆 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="4dp"
                android:text="@string/memory_profile_section"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/echoTextPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_profiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_profile_memory" />

            <TextView
                android:id="@+id/tv_empty_profiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/memory_no_profile"
                android:textSize="13sp"
                android:textColor="?attr/echoHint"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
