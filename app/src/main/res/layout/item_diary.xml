<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/echoSurface"
    app:strokeColor="?attr/echoBorder"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="17dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_date_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:textSize="11sp"
                android:textColor="?attr/echoTextSecondary"
                tools:text="6月24日" />

            <TextView
                android:id="@+id/tv_mood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:textColor="?attr/echoAccent"
                android:gravity="end"
                android:maxLines="1"
                tools:text="平静充实" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="20sp"
            android:textColor="?attr/echoTextPrimary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="今天的项目有了新进展" />

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="15sp"
            android:textColor="?attr/echoTextSecondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            tools:text="上午完成了代码审查，下午和团队讨论了新功能的设计方案..." />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:singleLine="true"
            app:chipSpacingHorizontal="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
