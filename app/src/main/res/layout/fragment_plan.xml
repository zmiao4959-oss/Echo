<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/echoBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- 标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="2dp"
                android:text="@string/plan_page_title"
                android:fontFamily="sans-serif-medium"
                android:textSize="32sp"
                android:textColor="?attr/echoTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp"
                android:text="@string/plan_page_subtitle"
                android:textSize="13sp"
                android:textColor="?attr/echoTextSecondary" />

            <!-- ═══ 任务提醒 ═══ -->
            <TextView
                android:id="@+id/tv_section_reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="任务提醒"
                android:drawableStart="@drawable/ic_plan_task"
                android:drawableTint="?attr/echoPrimary"
                android:drawablePadding="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/echoPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_reminder_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_plan" />

            <com.example.myapplication.ui.widget.ThemeStateView
                android:id="@+id/tv_empty_reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="暂无"
                android:textSize="12sp"
                android:textColor="?attr/echoHint"
                android:visibility="gone" />

            <!-- ═══ 主动问候 ═══ -->
            <TextView
                android:id="@+id/tv_section_checkin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:text="主动问候"
                android:drawableStart="@drawable/ic_plan_checkin"
                android:drawableTint="?attr/echoPrimary"
                android:drawablePadding="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/echoPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_checkin_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_plan" />

            <TextView
                android:id="@+id/tv_empty_checkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="暂无"
                android:textSize="12sp"
                android:textColor="?attr/echoHint"
                android:visibility="gone" />

            <!-- ═══ 回忆触发 ═══ -->
            <TextView
                android:id="@+id/tv_section_memory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:text="回忆触发"
                android:drawableStart="@drawable/ic_plan_memory"
                android:drawableTint="?attr/echoPrimary"
                android:drawablePadding="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/echoPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_memory_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_plan" />

            <TextView
                android:id="@+id/tv_empty_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="暂无"
                android:textSize="12sp"
                android:textColor="?attr/echoHint"
                android:visibility="gone" />

            <!-- ═══ 自动整理 ═══ -->
            <TextView
                android:id="@+id/tv_section_autodiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:text="自动整理"
                android:drawableStart="@drawable/ic_plan_diary"
                android:drawableTint="?attr/echoPrimary"
                android:drawablePadding="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/echoPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_autodiary_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_plan" />

            <TextView
                android:id="@+id/tv_empty_autodiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="暂无"
                android:textSize="12sp"
                android:textColor="?attr/echoHint"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB 新建规划（在导航栏上方） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_plan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/ic_echo_add"
        android:contentDescription="新建规划"
        app:backgroundTint="?attr/echoPrimary"
        app:tint="?attr/echoOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
