<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/echoBackground">

    <com.example.myapplication.ui.widget.EchoEnvironmentView
        android:id="@+id/echo_environment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部栏 -->

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@android:color/transparent"
            android:elevation="0dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_brand_mark"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="E"
                android:textColor="?attr/echoOnPrimary"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:text="@string/app_title"
                    android:textColor="?attr/echoTextPrimary"
                    android:textSize="18sp"
                    tools:ignore="VisualLintSystemUi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/app_subtitle"
                    android:textColor="?attr/echoTextSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_calendar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="日历"
                android:padding="10dp"
                android:src="@drawable/ic_calendar_outline"
                app:tint="?attr/echoTextSecondary" />

            <ImageButton
                android:id="@+id/btn_profile"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/profile_entry"
                android:padding="9dp"
                android:src="@drawable/ic_profile_outline" />
        </LinearLayout>

        <!-- Fragment 容器（底部留出导航栏空间） -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="88dp" />
    </LinearLayout>

    <com.example.myapplication.ui.widget.EchoJourneyView
        android:id="@+id/echo_journey"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 底部导航 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_navigation"
        android:elevation="10dp"
        android:minHeight="64dp"
        app:itemIconSize="23dp"
        app:itemPaddingBottom="7dp"
        app:itemPaddingTop="7dp"
        app:menu="@menu/bottom_nav"
        app:labelVisibilityMode="labeled"
        tools:ignore="VisualLintBottomNav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
