<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/echoBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_today"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ 问候区 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_today_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/echoTextSecondary"
                    android:textSize="13sp"
                    tools:text="2025年6月24日 星期二" />

                <LinearLayout
                    android:id="@+id/layout_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.example.myapplication.ui.widget.EchoWeatherView
                        android:id="@+id/weather_glyph"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tv_weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textColor="?attr/echoTextSecondary"
                        android:textSize="13sp"
                        tools:text="小雨 · 26℃" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:maxLines="2"
                    android:text="@string/today_greeting"
                    android:textColor="?attr/echoTextPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.example.myapplication.ui.widget.EchoOrbView
                android:id="@+id/echo_orb"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:importantForAccessibility="no"
                android:translationX="8dp" />
        </LinearLayout>

        <include layout="@layout/view_today_quick_input" />

        <!-- ═══ 最近 7 天：非连续记录足迹 ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_weekly_footprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="?attr/echoSurface"
            app:strokeColor="?attr/echoBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/weekly_footprint_title"
                        android:textColor="?attr/echoTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_weekly_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/echoPrimary"
                        android:textSize="12sp"
                        tools:text="4 天 · 9 个片段" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_weekly_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    tools:ignore="UselessLeaf" />

                <TextView
                    android:id="@+id/tv_weekly_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textColor="?attr/echoTextSecondary"
                    android:textSize="13sp"
                    tools:text="这一周有 4 天留下痕迹，你已经建立了自己的节奏。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ 临时反馈：微回声 / 回来就好 ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_today_spotlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/echoSurfaceVariant"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/echoBorder"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tv_today_spotlight_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/micro_echo_title"
                    android:textColor="?attr/echoPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_today_spotlight_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/echoTextPrimary"
                    android:textSize="14sp"
                    tools:text="这一刻已经留下了，Echo 正在回应…" />

                <TextView
                    android:id="@+id/tv_today_spotlight_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:text="@string/return_welcome_action"
                    android:textColor="?attr/echoPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layout_micro_echo_feedback_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_micro_echo_like"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/micro_echo_like"
                        android:textColor="?attr/echoPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_micro_echo_regenerate"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/micro_echo_regenerate"
                        android:textColor="?attr/echoTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<!-- ═══ 快速输入卡片 ═══ -->
        <!-- ═══ 今日片段标题 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/today_records_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/echoTextPrimary" />

            <TextView
                android:id="@+id/tv_record_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/echoPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                tools:text="查看全部 >" />
        </LinearLayout>

        <!-- ═══ LifeRecord 列表 ═══ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_life_record" />

        <!-- ═══ 空状态 ═══ -->
        <TextView
            android:id="@+id/tv_empty_records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/today_no_records"
            android:textSize="14sp"
            android:textColor="?attr/echoHint"
            android:visibility="gone" />

        <!-- ═══ 今日正在形成 ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_ai_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="?attr/echoSurfaceVariant"
            app:strokeColor="?attr/echoBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_ai_preview_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/echoPrimary" />

                <TextView
                    android:id="@+id/tv_diary_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textSize="13sp"
                    android:textColor="?attr/echoTextSecondary"
                    tools:text="3 个片段，已经让今天有了轮廓&#10;情绪线索 · 踏实&#10;浮现的主题 · 工作 · 运动&#10;几个分散的瞬间，正在连成今天的轮廓。" />

                <LinearLayout
                    android:id="@+id/btn_today_diary_action"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_today_diary_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/echoPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="整理成今日日记 ›" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ 小爪对话卡片 ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="4dp"
            android:text="@string/today_chat_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/echoTextPrimary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_chat_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="?attr/echoSurface"
            app:strokeColor="?attr/echoBorder"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_chat_card_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/echoPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/today_chat_card_subtitle"
                    android:textSize="14sp"
                    android:textColor="?attr/echoTextSecondary"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tv_last_reply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?attr/echoHint"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:text="最近: 是的，这确实是一个值得记录的想法..." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_enter_chat"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/today_enter_chat"
                        android:textSize="13sp"
                        android:textColor="?attr/echoPrimary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.example.myapplication.ui.widget.EchoCaptureMotionView
        android:id="@+id/capture_motion"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
