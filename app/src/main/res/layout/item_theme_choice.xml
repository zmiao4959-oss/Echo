<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="96dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/theme_preview"
        android:layout_width="68dp"
        android:layout_height="76dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/theme_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/echoTextPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/theme_kind"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_date_badge"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="?attr/echoTextSecondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/theme_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/echoTextSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/theme_swatches"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <TextView
        android:id="@+id/theme_check"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="✓"
        android:textColor="?attr/echoPrimary"
        android:textSize="20sp"
        android:visibility="invisible" />
</LinearLayout>
