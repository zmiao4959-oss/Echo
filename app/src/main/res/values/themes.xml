<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================================
    Echo 多主题系统 — Base + 5 套配色
    父主题 Theme.Material3.DayNight.NoActionBar 提供 M3 基础设施
    ============================================================ -->

    <!-- ── Base 层：M3 映射 + EchoCard 样式 ── -->
    <style name="Theme.MyApplication.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 属性映射到 echo 语义色 -->
        <item name="colorPrimary">?attr/echoPrimary</item>
        <item name="colorPrimaryDark">?attr/echoPrimaryDark</item>
        <item name="colorAccent">?attr/echoPrimary</item>
        <item name="android:colorBackground">?attr/echoBackground</item>
        <item name="colorSurface">?attr/echoSurface</item>
        <item name="colorOnPrimary">?attr/echoOnPrimary</item>
        <item name="colorOnSurface">?attr/echoTextPrimary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ── 卡片样式 ── -->
    <style name="EchoCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">?attr/echoSurface</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- ============================================================
    主题 1: 暖茶 (Warm Tea) — 默认，teal + 暖白
    ============================================================ -->
    <style name="Theme.MyApplication" parent="Theme.MyApplication.Base">
        <item name="echoPrimary">#2F7D7A</item>
        <item name="echoPrimaryDark">#1E5553</item>
        <item name="echoBackground">#FAF7F0</item>
        <item name="echoSurface">#FFFFFF</item>
        <item name="echoSurfaceVariant">#F3EFE7</item>
        <item name="echoTextPrimary">#163536</item>
        <item name="echoTextSecondary">#7A7A7A</item>
        <item name="echoAccent">#E9C98F</item>
        <item name="echoOnPrimary">#FFFFFF</item>
        <item name="echoBorder">#E0DCD5</item>
        <item name="echoDestructive">#E53935</item>
        <item name="echoHint">#BDBDBD</item>
        <item name="echoBubbleUser">#2F7D7A</item>
        <item name="echoBubbleAssistant">#F3EFE7</item>
        <item name="echoToolInfoBg">#F3EFE7</item>
    </style>

