<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Echo 温柔日记风 -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/echo_primary</item>
        <item name="colorPrimaryDark">@color/echo_primary_dark</item>
        <item name="colorAccent">@color/echo_primary</item>
        <item name="android:colorBackground">@color/echo_background</item>
        <item name="colorSurface">@color/echo_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/echo_text_primary</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <!-- Material3 卡片样式 -->
    <style name="EchoCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/echo_surface</item>
        <item name="contentPadding">16dp</item>
    </style>
</resources>
