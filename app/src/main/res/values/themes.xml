<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================================
    Echo 多主题系统 — Base + 5 套配色
    父主题 Theme.Material3.DayNight.NoActionBar 提供 M3 基础设施
    ============================================================ -->

    <!-- ── Base 层：M3 映射 + EchoCard 样式 ── -->
    <style name="Theme.MyApplication.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 属性映射到 echo 语义色 -->
        <item name="colorPrimary">?attr/echoPrimary</item>
        <item name="colorPrimaryDark">?attr/echoPrimaryDark</item>
        <item name="colorAccent">?attr/echoPrimary</item>
        <item name="android:colorBackground">?attr/echoBackground</item>
        <item name="colorSurface">?attr/echoSurface</item>
        <item name="colorSurfaceVariant">?attr/echoSurfaceVariant</item>
        <item name="colorSurfaceContainer">?attr/echoSurface</item>
        <item name="colorSurfaceContainerLow">?attr/echoSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/echoSurface</item>
        <item name="colorSurfaceContainerHighest">?attr/echoSurfaceVariant</item>
        <item name="colorOnPrimary">?attr/echoOnPrimary</item>
        <item name="colorOnSurface">?attr/echoTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/echoTextSecondary</item>
        <item name="colorOnBackground">?attr/echoTextPrimary</item>
        <item name="colorOutline">?attr/echoBorder</item>
        <item name="colorOutlineVariant">?attr/echoBorder</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Echo.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Echo.AlertDialog</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Echo.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Echo.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Echo.Large</item>
    </style>

    <style name="ThemeOverlay.Echo.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_echo_dialog</item>
        <item name="colorSurface">?attr/echoSurface</item>
        <item name="colorOnSurface">?attr/echoTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/echoTextSecondary</item>
    </style>

    <style name="ShapeAppearance.Echo.Small" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Echo.Medium" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Echo.Large" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- ── 卡片样式 ── -->
    <style name="EchoCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/echoSurface</item>
        <item name="strokeColor">?attr/echoBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

